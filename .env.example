# CareQueue local stack settings. Copy to .env, or run scripts/new-env.ps1 to generate .env with
# strong random secrets. NEVER commit .env. Every CHANGE_ME value must be replaced.

# Stack identity: container, network and volume names are prefixed with this.
# Must differ from any other CareQueue stack on the same machine.
CQ_STACK=carequeue-v2

# Host bind address. 127.0.0.1 keeps every published port off the network.
CQ_BIND_ADDRESS=127.0.0.1

# Host ports (these must not collide with another running stack).
FRONTEND_HOST_PORT=3001
BACKEND_HOST_PORT=8081
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
KAFKA_HOST_PORT=9093

# Database
DATABASE_NAME=carequeue
DATABASE_USERNAME=carequeue
DATABASE_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Redis (required; used by the backend and the health check)
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# JWT signing key: at least 32 random bytes, hex. Generate with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_HEX_CHARACTERS

# Password for the admin account created on the first start of an empty database.
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Hospital timezone for "today" and "now" in business logic.
CAREQUEUE_TIMEZONE=Asia/Kolkata
